declare -a vars=(LALA BLA)
pass_to_get=0
if ! $(pass-cli info -o json | jq '.username' > /dev/null 2>&1)
then
        echo "Logging into proton pass..."
        pass-cli login
        pass_to_get=1
else
        echo "Valid proton pass token found."
        pass_to_get=1
fi

if [[ "$pass_to_get" == 1 ]]; then
        json=$(pass-cli item view --output json --share-id KyE3n1ezZPiMKJSXHpj0dKjV9fVgH-xOwSZHZ41meXcRCjhXEIXfnk9d4DiLnCpcpzgL1pWZY9cTzBxSU0IgNw== --item-id d4gCv9_MZgdTM-hZS9G0_VkU5P7lMjFVFFCvdAyXbwo2_8rKd4QdUfDevo5yyro27StVacrYvUnppFLZlzCsMw==)
        export LALA="$(echo $json | jq -Rnr '[inputs] | join("") | fromjson | .item.content.content.Login.email')"
	export BLA="$(echo $json | jq -Rnr '[inputs] | join("") | fromjson | .item.content.content.Login.password')"
fi
