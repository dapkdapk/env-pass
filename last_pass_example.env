declare -a vars=(USERNAME PASSWORD FELD1 FELD2)
pass_to_get=0
if ! $(lpass ls > /dev/null 2>&1)
then
    echo "Logging into last pass..." 
    echo -n "LastPass username: "
    read username
    lpass login $username
    pass_to_get=1
else
    echo "Valid last pass login found."
    lpass status
    pass_to_get=1
fi

if [[ "$pass_to_get" == 1 ]]; then
    lines=$(lpass show 7478234270784347397)
    export USERNAME="$(echo "$lines" | grep '^Username:' | cut -d' ' -f2)"
    export PASSWORD="$(echo "$lines" | grep '^Password:' | cut -d' ' -f2)"
    export FELD1="$(echo "$lines" | grep '^feld1:' | cut -d' ' -f2)"
    export FELD2="$(echo "$lines" | grep '^feld2:' | cut -d' ' -f2)"
fi
